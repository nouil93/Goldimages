{
  "builders": [{
    "type": "qemu",
    "accelerator": "kvm",
    "iso_checksum": "{{ user `iso_checksum_type` }}:{{ user `iso_checksum` }}",
    "iso_url": "{{ user `iso_url` }}",
    "output_directory": "{{ user `output_directory` }}",
    "cpus": "{{user `cpus`}}",
    "memory": "{{user `memory`}}",
    "vm_name": "{{ user `vm_name` }}",
    "disk_size": "{{user `disk_size`}}",
    "headless": "{{user `headless`}}",
    "http_directory": "http",
    "qemuargs": [
      ["-m", "2048"],
      ["-smp", "2"]
    ],
    "format": "qcow2",
    "display": "sdl",
    "ssh_password": "{{ user `ssh_password` }}",
    "ssh_username": "{{ user `ssh_username` }}",
    "ssh_timeout": "{{user `ssh_timeout`}}",
    "shutdown_command": "/sbin/poweroff",
    "net_device": "virtio-net",
    "disk_interface": "virtio-scsi",
    "disk_compression": "true",
    "disk_detect_zeroes": "on",
    "boot_wait": "3s",
    "boot_command": [
      "<wait4>",
      "<enter><wait2>root<enter><wait>",
      "ifconfig eth0 up && udhcpc -i eth0<enter><wait5>",
      "wget http://{{ .HTTPIP }}:{{ .HTTPPort }}/alpine/{{ user `alpine_version` }}/answers<enter><wait>",
      "setup-alpine -f $PWD/answers<enter><wait5>",
      "vagrant<enter><wait>",
      "vagrant<enter><wait>",
      "<wait10><wait10>",
      "y<enter>",
      "<wait10><wait10><wait10>",
      "rc-service sshd stop<enter>",
      "mount {{ user `alpine_system_part` }} /mnt<enter>",
      "echo 'PermitRootLogin yes' >> /mnt/etc/ssh/sshd_config<enter>",
      "echo http://dl-cdn.alpinelinux.org/alpine/edge/community >> /mnt/etc/apk/repositories<enter>",
      "mount -t proc none /mnt/proc<enter>",
      "mount -o bind /sys /mnt/sys<enter>",
      "mount -o bind /dev /mnt/dev<enter>",
      "chroot /mnt /bin/sh -l<enter>",
      "apk update<enter>",
      "apk add bash curl rsyslog ruby shadow sudo python3<enter><wait>",
      "<wait20>",
      "groupadd vagrant<enter>",
      "useradd vagrant -g vagrant -G wheel -m<enter>",
      "passwd vagrant<enter><wait>",
      "vagrant<enter><wait>",
      "vagrant<enter><wait>",
      "echo 'vagrant        ALL=(ALL)       NOPASSWD: ALL' >> /etc/sudoers<enter>",
      "exit<enter><wait10>",
      "umount /mnt/proc<enter>",
      "umount /mnt/sys<enter>",
      "umount /mnt/dev<enter>",
      "umount /mnt<enter>",
      "reboot<enter>"
    ]
  }],
  "provisioners": [{
    "type": "ansible",
    "playbook_file": "{{user `playbook_file`}}"
  }],
  "post-processors":
  [
    {
      "type": "shell-local",
      "script": "scripts/ppqcow2boxbuilder.sh",
      "environment_vars": [
        "vm_name={{ user `vm_name` }}",
        "vm_type={{ user `vm_type` }}"
      ]
    }
  ],
  "variables": {
    "alpine_system_part": "/dev/vda3",
    "output_directory": "goldimage",
    "alpine_version": "",
    "qemu_accelerator": "kvm",
    "vm_disk_adapter_type": "scsi",
    "vm_disk_size": "36864",
    "vm_memory": "512",
    "vm_name": "",
    "ssh_password": "vagrant",
    "ssh_username": "root",
    "ssh_timeout": "60m",
    "cpus": "1",
    "disk_size": "20480",
    "headless": "false",
    "memory": "1024",
    "iso_checksum": "",
    "iso_checksum_type": "",
    "iso_url": "",
    "playbook_file": "provisioners/ansible/opennebula.yml"
  }
}
