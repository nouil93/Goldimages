{
  "builders": [{
    "type": "qemu",
    "iso_url": "./soclelinux-2016.0.14-custom.iso",
    "iso_checksum": "bccdeb8baec1785772ed7a1045983ff6",
    "iso_checksum_type": "md5",
    "output_directory": "dist",
    "vm_name": "soclelinux-2016.0.14-{{user `profil`}}",
    "disk_size": "{{user `disk_size`}}",
    "headless": "{{user `headless`}}",
    "http_directory": "http",
    "accelerator": "kvm",
    "boot_wait": "3s",
    "boot_command": [
      "{{user `profil`}}<enter>"
    ],
    "format": "qcow2",
    "display": "sdl",
    "ssh_username": "root",
    "ssh_password": "master",
    "ssh_timeout": "{{user `ssh_timeout`}}",
    "shutdown_command": "systemctl poweroff",
    "net_device": "virtio-net",
    "disk_interface": "virtio",
    "disk_compression": "true",
    "disk_detect_zeroes": "on",
    "qemuargs": [
      ["-m", "{{user `memory`}}"],
      ["-smp", "{{user `cpus`}}"],
      [ "-k", "fr" ]
    ]
  }],
  "provisioners": [{
    "type": "shell",
    "scripts": [
      "{{user `provisioner_script`}}"
    ]
  }],
  "post-processors":
  [
    {
      "type": "manifest",
      "output": "dist/soclelinux_manifest.json"
    },
    {
      "type": "shell-local",
      "inline": [
        "echo -n 'Lancement de virt-sysprep'",
        "sudo /usr/bin/virt-sysprep -a dist/soclelinux-2016.0.14-{{user `profil`}}",
        "echo -n 'Lancement de virt-sparsify'",
        "sudo /usr/bin/virt-sparsify --tmp /tmp dist/soclelinux-2016.0.14-{{user `profil`}} dist/soclelinux-2016.0.14-{{user `profil`}}.qcow2",
        "echo -n 'suppression image raw'",
        "rm dist/soclelinux-2016.0.14-{{user `profil`}}"
      ]
    }
  ],
  "variables": {
    "compression_level": "9",
    "cpus": "2",
    "disk_size": "20480",
    "headless": "false",
    "memory": "1024",
    "ssh_timeout": "60m",
    "provisioner_script": "scripts/one_context.sh",
    "profil": "{{env `SOCLEPROFIL`}}"
  }
}
