{
  "builders": [{
    "type": "qemu",
    "iso_checksum_type": "{{ user `iso_checksum_type` }}",
    "iso_checksum": "{{ user `iso_checksum` }}",
    "iso_url": "{{ user `iso_url` }}",
    "output_directory": "{{ user `tmp_directory` }}",
    "vm_name": "{{ user `vm_name` }}",
    "disk_size": "{{user `disk_size`}}",
    "headless": "{{user `headless`}}",
    "http_directory": "http",
    "accelerator": "kvm",
    "boot_wait": "3s",
    "boot_command": [
      "<tab> {{ user `boot_command_prefix` }}=http://{{ .HTTPIP }}:{{ .HTTPPort }}/fedora/{{user `kickstart`}} <enter><wait>"
    ],
    "format": "qcow2",
    "display": "sdl",
    "ssh_password": "{{ user `ssh_password` }}",
    "ssh_username": "{{ user `ssh_username` }}",
    "ssh_timeout": "{{user `ssh_timeout` }}",
    "shutdown_command": "echo '/sbin/halt -h -p' > shutdown.sh; echo 'packer'|sudo -S bash 'shutdown.sh'",
    "net_device": "virtio-net",
    "disk_interface": "virtio",
    "disk_compression": "true",
    "disk_detect_zeroes": "on",
    "qemuargs": [
      ["-m", "{{user `memory`}}"],
      ["-smp", "{{user `cpus`}}"],
      ["-option-rom", "/usr/share/qemu/pxe-rtl8139.rom"]
    ]
  }],
  "provisioners": [{
    "type": "shell",
    "scripts": [
      "scripts/base.sh",
      "scripts/vagrant.sh"
    ]
  },{
    "type": "ansible",
    "playbook_file": "{{user `playbook_file`}}",
    "extra_arguments": [ "--extra-vars", "ansible_python_interpreter=/usr/bin/python3" ]
  }],
  "post-processors":
  [
    {
      "type": "manifest",
      "output": "{{ user `output_directory` }}/{{ user `vm_name` }}-manifest.json"
    },
    {
      "compression_level": "{{ user `compression_level` }}",
      "output": "{{ user `output_directory` }}/{{ user `vm_name` }}.box",
      "type": "vagrant"
    },
    {
      "type": "shell-local",
      "inline": [
        "echo -n 'virt-sysprep...'",
        "sudo /usr/bin/virt-sysprep -a {{ user `tmp_directory` }}/{{ user `vm_name` }}",
        "echo -n 'virt-sparsify...'",
        "sudo /usr/bin/virt-sparsify --in-place --machine-readable {{ user `tmp_directory` }}/{{ user `vm_name` }}",
        "echo -n 'deplacement image'",
        "mv {{ user `tmp_directory` }}/{{ user `vm_name` }} {{ user `output_directory` }}/{{ user `vm_name` }}.qcow2"
      ]
    }
  ],
  "variables": {
    "compression_level": "9",
    "output_directory": "",
    "tmp_directory": "dist",
    "cpus": "2",
    "disk_size": "20480",
    "headless": "false",
    "memory": "1024",
    "ssh_timeout": "60m",
    "ssh_password": "vagrant",
    "ssh_username": "vagrant",
    "boot_command_prefix": "inst.text inst.ks",
    "iso_checksum": "",
    "iso_checksum_type": "",
    "iso_url": "",
    "vm_name": "",
    "description": "",
    "short_description": "",
    "kickstart": "ks-min.cfg",
    "playbook_file": "provisioners/ansible/playbook.yml"
  }
}
