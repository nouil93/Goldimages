{
  "builders": [{
    "type": "qemu",
    "iso_checksum": "{{ user `iso_checksum_type` }}:{{ user `iso_checksum` }}",
    "iso_url": "{{ user `iso_url` }}",
    "output_directory": "{{ user `output_directory` }}",
    "vm_name": "{{ user `vm_name` }}",
    "disk_size": "{{user `disk_size`}}",
    "headless": "{{user `headless`}}",
    "http_directory": "http",
    "accelerator": "kvm",
    "boot_wait": "3s",
    "boot_command": [
      "<tab> {{ user `boot_command_prefix` }}=http://{{ .HTTPIP }}:{{ .HTTPPort }}/fedora/{{user `kickstart`}} <enter><wait>"
    ],
    "format": "qcow2",
    "display": "sdl",
    "ssh_password": "{{ user `ssh_password` }}",
    "ssh_username": "{{ user `ssh_username` }}",
    "ssh_timeout": "{{user `ssh_timeout` }}",
    "shutdown_command": "echo '/sbin/halt -h -p' > shutdown.sh; echo 'packer'|sudo -S bash 'shutdown.sh'",
    "net_device": "virtio-net",
    "disk_interface": "virtio",
    "disk_compression": "true",
    "disk_detect_zeroes": "on",
    "qemuargs": [
      ["-m", "{{user `memory`}}"],
      ["-smp", "{{user `cpus`}}"]
    ]
  }],
  "provisioners": [{
    "type": "ansible",
    "playbook_file": "{{user `playbook_file`}}",
    "extra_arguments": [ "--extra-vars", "ansible_python_interpreter=/usr/bin/python3", "-vvvv" ]
  }],
  "post-processors":
  [
    {
      "type": "shell-local",
      "script": "scripts/ppvagrantboxbuilder.sh",
      "environment_vars": [
        "vm_name={{ user `vm_name` }}",
        "vm_type={{ user `vm_type` }}"
      ]
    }
  ],
  "variables": {
    "output_directory": "goldimage",
    "cpus": "2",
    "disk_size": "20480",
    "headless": "false",
    "memory": "1024",
    "ssh_timeout": "60m",
    "ssh_password": "vagrant",
    "ssh_username": "vagrant",
    "boot_command_prefix": "inst.text inst.ks",
    "iso_checksum": "",
    "iso_checksum_type": "",
    "iso_url": "",
    "vm_name": "",
    "vm_type": "vagrant",
    "description": "",
    "short_description": "",
    "kickstart": "ks_vagrant.cfg",
    "playbook_file": "provisioners/ansible/vagrant.yml"
  }
}
